<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:mood_tracker.Pages"
       x:Class="mood_tracker.AppShell"
       FlyoutBehavior="Disabled"
       Title="Tend">

    <ShellContent Route="login"
                  Title="Sign in"
                  ContentTemplate="{DataTemplate pages:LoginPage}"/>

    <ShellContent Route="onboarding"
                  Title="Tend"
                  Shell.TabBarIsVisible="False"
                  Shell.NavBarIsVisible="False"
                  ContentTemplate="{DataTemplate pages:OnboardingPage}"/>

    <TabBar Route="main">
        <ShellContent Title="Today"
                      Route="today"
                      ContentTemplate="{DataTemplate pages:TodayPage}"/>
        <ShellContent Title="History"
                      Route="history"
                      ContentTemplate="{DataTemplate pages:HistoryPage}"/>
    </TabBar>
</Shell>
