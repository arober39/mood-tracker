<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:mood_tracker.ViewModels"
             xmlns:ctrl="clr-namespace:mood_tracker.Controls"
             x:Class="mood_tracker.Pages.EntryDetailPage"
             x:DataType="vm:EntryDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="24,72,24,40" Spacing="28">

            <Label Text="‹ Back"
                   FontFamily="OpenSansSemibold"
                   FontSize="15"
                   TextColor="{StaticResource Ink}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}"/>
                </Label.GestureRecognizers>
            </Label>

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Weekday}" Style="{StaticResource Eyebrow}"/>
                <Label Text="{Binding DateLine}" Style="{StaticResource HeadlineSerif}"/>
                <Label Text="{Binding Time}" Style="{StaticResource BodyMuted}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                <ctrl:MoodOrbView Score="{Binding Score}" OrbSize="150" HorizontalOptions="Center"/>
                <Label Text="{Binding Label}"
                       Style="{StaticResource TitleSerif}"
                       FontSize="26"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Feeling chips -->
            <CollectionView ItemsSource="{Binding Feelings}" HeightRequest="48" HorizontalOptions="Center">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border BackgroundColor="{StaticResource SurfaceMuted}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,8">
                            <Label Text="{Binding .}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="{StaticResource Ink}"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="{StaticResource Hairline}"/>

            <!-- Note (or empty-state) -->
            <Label Text="{Binding Note}"
                   FontFamily="Georgia"
                   FontSize="17"
                   TextColor="{StaticResource Ink}"
                   FontAttributes="{Binding HasNote, Converter={StaticResource HasNoteToFontAttr}}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
