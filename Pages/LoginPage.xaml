<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:mood_tracker.ViewModels"
             x:Class="mood_tracker.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="32,80,32,40" Spacing="24" VerticalOptions="Center">

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Tend"
                       Style="{StaticResource DisplaySerif}"
                       FontSize="46"
                       HorizontalOptions="Center"/>
                <Label Text="A quiet check-in with yourself."
                       Style="{StaticResource BodyMuted}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" Margin="0,32,0,0">
                <Border Stroke="{StaticResource Hairline}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,4">
                    <Entry x:Name="UsernameEntry"
                           Placeholder="Username"
                           PlaceholderColor="{StaticResource InkMuted}"
                           TextColor="{StaticResource Ink}"
                           BackgroundColor="Transparent"
                           Text="{Binding Username}"/>
                </Border>

                <Border Stroke="{StaticResource Hairline}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,4">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Password"
                           PlaceholderColor="{StaticResource InkMuted}"
                           TextColor="{StaticResource Ink}"
                           BackgroundColor="Transparent"
                           IsPassword="True"
                           Text="{Binding Password}"/>
                </Border>

                <Button Text="Sign in"
                        Command="{Binding SignInCommand}"
                        BackgroundColor="{StaticResource Ink}"
                        TextColor="{StaticResource Surface}"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        CornerRadius="28"
                        HeightRequest="56"
                        Margin="0,8,0,0"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
