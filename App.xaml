<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:mood_tracker.Converters"
             xmlns:local="clr-namespace:mood_tracker"
             x:Class="mood_tracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBool"/>
            <conv:ScoreToLabelConverter x:Key="ScoreToLabel"/>
            <conv:HasNoteToFontAttrConverter x:Key="HasNoteToFontAttr"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
